# Configuración de variables de entorno para testing
APP_ENV=testing
APP_DEBUG=true

# Base de datos de testing
DB_HOST=localhost
DB_NAME=sistema_biometrico_test
DB_USER=root
DB_PASS=root

# Configuración de testing
BASE_URL=http://localhost:8000
ENCRYPTION_KEY=test_encryption_key_32_characters!!
CACHE_DRIVER=array
SESSION_DRIVER=array
MAIL_DRIVER=array

# Logs y debugging
LOG_LEVEL=debug
LOG_PATH=tests/logs/

# Timezone
TIMEZONE=America/Mexico_City