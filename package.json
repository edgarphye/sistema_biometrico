{
  "name": "sistema-biometrico",
  "version": "1.0.0",
  "description": "Sistema Biométrico de Control de Asistencia",
  "main": "index.js",
  "scripts": {
    "test": "php vendor/bin/phpunit --configuration phpunit.xml",
    "test:unit": "php vendor/bin/phpunit --testsuite Unit",
    "test:integration": "php vendor/bin/phpunit --testsuite Integration",
    "test:api": "php vendor/bin/phpunit --testsuite API",
    "test:security": "php vendor/bin/phpunit --testsuite Security",
    "test:performance": "php vendor/bin/phpunit --testsuite Performance",
    "test:coverage": "php vendor/bin/phpunit --configuration phpunit.xml --coverage-html tests/coverage",
    "test:e2e": "cypress open",
    "test:e2e:headless": "cypress run",
    "cypress:install": "cypress install",
    "cypress:verify": "cypress verify",
    "performance:ab": "bash scripts/performance-test.sh",
    "security:zap": "bash scripts/security-scan.sh",
    "lint:php": "vendor/bin/phpcs --standard=PSR-12 src/ models/ controllers/ api/ helpers/",
    "lint:php:fix": "vendor/bin/phpcbf --standard=PSR-12 src/ models/ controllers/ api/ helpers/",
    "lint:js": "eslint assets/js/",
    "lint:css": "stylelint public/css/",
    "analyze": "vendor/bin/phpstan analyse --memory-limit=2G --level=5 src/",
    "build:css": "npm run css:concat && npm run css:minify",
    "build:js": "npm run js:concat && npm run js:minify",
    "css:concat": "cat public/css/*.css > dist/bundle.css",
    "css:minify": "cleancss -o dist/bundle.min.css dist/bundle.css",
    "js:concat": "cat assets/js/*.js > dist/bundle.js",
    "js:minify": "uglifyjs dist/bundle.js -o dist/bundle.min.js",
    "minify": "npm run build:css && npm run build:js",
    "optimize": "npm run minify && npm run optimize:images",
    "optimize:images": "bash scripts/optimize-images.sh",
    "dev": "php -S localhost:8000 -t .",
    "watch": "npm run dev & npm run watch:css & npm run watch:js",
    "watch:css": "onchange 'public/css/*.css' -- npm run build:css",
    "watch:js": "onchange 'assets/js/*.js' -- npm run build:js",
    "deploy:staging": "bash scripts/deploy-staging.sh",
    "deploy:production": "bash scripts/deploy-production.sh",
    "backup": "bash scripts/backup.sh",
    "migrate": "php migrations/run_migrations.php",
    "seed": "php scripts/seed-database.php",
    "cache:clear": "php cache/clear-cache.php",
    "cache:warm": "php cache/warm-up-cache.php",
    "docs:generate": "php scripts/generate-docs.php",
    "docs:serve": "http-server docs/ -p 8081 -c-1",
    "health": "curl -f http://localhost:8000/api/health || exit 1",
    "precommit": "npm run lint:php && npm run analyze && npm run test:unit",
    "ci": "npm run lint:php && npm run analyze && npm run test && npm run test:e2e:headless",
    "start": "npm run dev"
  },
  "keywords": [
    "biometric",
    "attendance",
    "php",
    "mysql",
    "cypress",
    "testing",
    "security",
    "performance"
  ],
  "author": "Sistema Biométrico Team",
  "license": "MIT",
  "devDependencies": {
    "cypress": "^13.6.0",
    "cypress-multi-reporters": "^1.6.4",
    "mochawesome": "^7.1.3",
    "mocha-junit-reporter": "^2.2.0",
    "eslint": "^8.56.0",
    "stylelint": "^16.1.0",
    "uglify-js": "^3.17.4",
    "clean-css-cli": "^5.6.3",
    "onchange": "^7.1.0",
    "http-server": "^14.1.1",
    "@babel/core": "^7.23.6",
    "@babel/preset-env": "^7.23.6",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "file-loader": "^6.2.0",
    "url-loader": "^4.1.1"
  },
  "dependencies": {
    "bootstrap": "^5.3.2",
    "font-awesome": "^4.7.0",
    "jquery": "^3.7.1",
    "popper.js": "^1.16.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": true,
    "stepDefinitions": "tests/E2E/step_definitions/"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie <= 11"
  ]
}