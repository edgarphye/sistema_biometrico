# ═══════════════════════════════════════════════════════════════
# CONFIGURACIÓN DE PRODUCCIÓN - Sistema Biométrico
# ═══════════════════════════════════════════════════════════════
# 
# IMPORTANTE: 
# - NO subir este archivo a repositorios públicos
# - Agregarlo a .gitignore
# - Usar valores diferentes para desarrollo/producción
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# 1. SEGURIDAD Y CIFRADO
# ─────────────────────────────────────────────────────────────

# Clave de cifrado para datos biométricos (AES-256-CBC)
# Generada: 2025-11-26
# CRÍTICO: Si se pierde esta clave, NO se podrán descifrar datos existentes
ENCRYPTION_KEY=3d7e0f3fb2533d2d8c1f534ba0301632a298c17c3bb26fd7ce5db2ae2153d5d3

# ─────────────────────────────────────────────────────────────
# 2. BASE DE DATOS
# ─────────────────────────────────────────────────────────────

DB_HOST=localhost
DB_USER=root
DB_PASS=root
DB_NAME=sistema_biometrico

# ─────────────────────────────────────────────────────────────
# 3. APLICACIÓN
# ─────────────────────────────────────────────────────────────

APP_NAME=Sistema Biométrico
APP_VERSION=1.0
BASE_URL=/sistema_biometrico

# ─────────────────────────────────────────────────────────────
# 4. BIOMETRÍA (ZKTeco)
# ─────────────────────────────────────────────────────────────

# Modo: "simulation" (desarrollo) o "sdk" (producción)
BIOMETRIC_MODE=simulation

# Configuración SDK (solo si BIOMETRIC_MODE=sdk)
BIOMETRIC_SDK_CLASS=ZKTecoSDK
BIOMETRIC_API_URL=https://api.zkteco.com
BIOMETRIC_API_KEY=

# Debug (0=off, 1=on)
BIOMETRIC_DEBUG=0

# ─────────────────────────────────────────────────────────────
# 5. CONFIGURACIÓN RH
# ─────────────────────────────────────────────────────────────

# Tolerancia en minutos para retardos menores
TOLERANCE_MINUTES=10

# ─────────────────────────────────────────────────────────────
# 6. LOGGING Y MONITOREO
# ─────────────────────────────────────────────────────────────

LOG_LEVEL=INFO
LOG_PATH=logs/sistema_biometrico.log

# ═══════════════════════════════════════════════════════════════
# NOTAS DE CONFIGURACIÓN
# ═══════════════════════════════════════════════════════════════
#
# DESARROLLO vs PRODUCCIÓN:
# -------------------------
# - Desarrollo: BIOMETRIC_MODE=simulation, BIOMETRIC_DEBUG=1
# - Producción: BIOMETRIC_MODE=sdk, BIOMETRIC_DEBUG=0
#
# ENCRYPTION_KEY:
# ---------------
# - Generar nueva clave: php setup_encryption_key.php
# - Backup seguro: Guardar en gestor de contraseñas
# - NO compartir entre entornos
#
# DISPOSITIVOS BIOMÉTRICOS:
# ------------------------
# - 35 dispositivos pre-configurados con IPs únicas
# - Ver tabla: dispositivos_biometricos
# - Gestión: /dispositivos
#
# ═══════════════════════════════════════════════════════════════
